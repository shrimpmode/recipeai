DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

POSTGRES_DB=nutrition
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

# Origins the Next.js frontend is served from (trusted for CSRF), comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# The LLM that picks and describes AI search results, as "provider:model".
# Providers: anthropic, openai (also any OpenAI-compatible endpoint via OPENAI_BASE_URL).
AI_SEARCH_MODEL=anthropic:claude-haiku-4-5-20251001
# Only the key for AI_SEARCH_MODEL's provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
