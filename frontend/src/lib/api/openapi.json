{
    "openapi": "3.0.3",
    "info": {
        "title": "Nutrition API",
        "version": "1"
    },
    "paths": {
        "/api/auth/csrf": {
            "get": {
                "operationId": "auth_csrf",
                "description": "Sets the `csrftoken` cookie; call once before the first unsafe request.",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "operationId": "auth_login",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Me"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "operationId": "auth_logout",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "operationId": "auth_me",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Me"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/profile": {
            "get": {
                "operationId": "profile_get_goals",
                "tags": [
                    "profile"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Goals"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "put": {
                "operationId": "profile_update_goals",
                "tags": [
                    "profile"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/GoalsRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Goals"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/queries": {
            "post": {
                "operationId": "queries_submit_query",
                "description": "Queue an AI search; poll `GET /api/queries/{id}` until status is done or error.\nThe error text is logged server-side, not returned: it can contain provider details.",
                "tags": [
                    "queries"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/QueryInRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "202": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/QueryOut"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/queries/{query_request_id}": {
            "get": {
                "operationId": "queries_query_status",
                "parameters": [
                    {
                        "in": "path",
                        "name": "query_request_id",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "queries"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/QueryOut"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/search": {
            "get": {
                "operationId": "recipes_keyword_search",
                "description": "Search without AI: synchronous, at most KEYWORD_SEARCH_RESULT_COUNT recipes.\n`elapsed_ms` is database search time, measured here.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "search"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SearchOut"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "No response body"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CredentialsRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 150
                    },
                    "password": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "Goals": {
                "type": "object",
                "description": "PUT replaces every goal: a field left out is cleared (default None).",
                "properties": {
                    "daily_calorie_target": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "protein_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "carbs_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "fat_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "fiber_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    }
                }
            },
            "GoalsRequest": {
                "type": "object",
                "description": "PUT replaces every goal: a field left out is cleared (default None).",
                "properties": {
                    "daily_calorie_target": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "protein_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "carbs_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "fat_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    },
                    "fiber_target_g": {
                        "type": "number",
                        "format": "double",
                        "maximum": 20000,
                        "minimum": 0,
                        "nullable": true
                    }
                }
            },
            "Me": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "is_staff": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "is_staff",
                    "username"
                ]
            },
            "Message": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "detail"
                ]
            },
            "QueryInRequest": {
                "type": "object",
                "properties": {
                    "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                },
                "required": [
                    "prompt"
                ]
            },
            "QueryOut": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "status": {
                        "$ref": "#/components/schemas/QueryStatus"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ResultOut"
                        },
                        "nullable": true
                    },
                    "elapsed_seconds": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                },
                "required": [
                    "elapsed_seconds",
                    "id",
                    "results",
                    "status"
                ]
            },
            "QueryStatus": {
                "enum": [
                    "pending",
                    "running",
                    "done",
                    "error"
                ],
                "type": "string",
                "description": "* `pending` - Pending\n* `running` - Running\n* `done` - Done\n* `error` - Error"
            },
            "RecipeOut": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "recipe_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "source_url": {
                        "type": "string",
                        "format": "uri",
                        "readOnly": true
                    },
                    "image_url": {
                        "type": "string",
                        "format": "uri",
                        "readOnly": true,
                        "nullable": true
                    },
                    "calories_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "protein_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "carbs_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "fat_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "fiber_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "sugar_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    },
                    "sodium_mg_per_serving": {
                        "type": "number",
                        "format": "double",
                        "readOnly": true,
                        "nullable": true
                    }
                },
                "required": [
                    "calories_per_serving",
                    "carbs_g_per_serving",
                    "fat_g_per_serving",
                    "fiber_g_per_serving",
                    "id",
                    "image_url",
                    "protein_g_per_serving",
                    "recipe_name",
                    "sodium_mg_per_serving",
                    "source_url",
                    "sugar_g_per_serving"
                ]
            },
            "ResultOut": {
                "type": "object",
                "description": "One entry of `QueryRequest.results` (see `queries.tasks._serialize_result`).",
                "properties": {
                    "recipe_id": {
                        "type": "integer"
                    },
                    "recipe_name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "source_url": {
                        "type": "string"
                    },
                    "image_url": {
                        "type": "string",
                        "nullable": true
                    },
                    "calories_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "protein_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "carbs_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "fat_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "fiber_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "sugar_g_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "sodium_mg_per_serving": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                },
                "required": [
                    "calories_per_serving",
                    "carbs_g_per_serving",
                    "description",
                    "fat_g_per_serving",
                    "fiber_g_per_serving",
                    "image_url",
                    "protein_g_per_serving",
                    "recipe_id",
                    "recipe_name",
                    "sodium_mg_per_serving",
                    "source_url",
                    "sugar_g_per_serving"
                ]
            },
            "SearchOut": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RecipeOut"
                        }
                    },
                    "elapsed_ms": {
                        "type": "number",
                        "format": "double"
                    }
                },
                "required": [
                    "elapsed_ms",
                    "query",
                    "results"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}