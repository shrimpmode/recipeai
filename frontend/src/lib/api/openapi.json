            "title": "Image Url"
          },
          "calories_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calories Per Serving"
          },
          "protein_g_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protein G Per Serving"
          },
          "carbs_g_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carbs G Per Serving"
          },
          "fat_g_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fat G Per Serving"
          },
          "fiber_g_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fiber G Per Serving"
          },
          "sugar_g_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sugar G Per Serving"
          },
          "sodium_mg_per_serving": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sodium Mg Per Serving"
          }
        },
        "required": [
          "recipe_id",
          "recipe_name",
          "description",
          "source_url",
          "image_url",
          "calories_per_serving",
          "protein_g_per_serving",
          "carbs_g_per_serving",
          "fat_g_per_serving",
          "fiber_g_per_serving",
          "sugar_g_per_serving",
          "sodium_mg_per_serving"
        ],
        "title": "ResultOut",
        "type": "object"
      },
      "Status": {
        "enum": [
          "pending",
          "running",
          "done",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "QueryIn": {
        "properties": {
          "prompt": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
